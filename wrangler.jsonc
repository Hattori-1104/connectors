{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "connectors",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-22",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "connectors.hattori-dev.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
